        <attribute name="edited" value="dWNlbmlrO1gzMVIwMTsyMDI1LTEwLTEzOyIwOTowNDoyNyAiOzI7MjMwNg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Real" array="False" size=""/>
            <declare name="b" type="Real" array="False" size=""/>
            <declare name="povrsina" type="Real" array="False" size=""/>
            <declare name="opseg" type="Real" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <assign variable="opseg" expression="2*a+2*b"/>
            <assign variable="povrsina" expression="a*b"/>
            <output expression="&quot;Opseg pravokutnika iznosi: &quot; &amp; opseg" newline="True"/>
            <output expression="&quot;Povrsina pravokutnika iznosi: &quot; &amp; povrsina" newline="True"/>
        </body>
    </function>
</flowgorithm>
