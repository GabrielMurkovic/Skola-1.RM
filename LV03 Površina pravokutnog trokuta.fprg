    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Real" array="False" size=""/>
            <declare name="b" type="Real" array="False" size=""/>
            <declare name="Hipotenuza" type="Real" array="False" size=""/>
            <declare name="Povrsina" type="Real" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <assign variable="Hipotenuza" expression="sqrt(a^2 + b^2)"/>
            <assign variable="Povrsina" expression="(a * b) / 2"/>
            <output expression="&quot;Ispi&#353;i Hipotenuzu:&quot;&amp; Hipotenuza" newline="True"/>
            <output expression="&quot;Ispi&#353;i Povrsinu:&quot;&amp;Povrsina" newline="True"/>
        </body>
    </function>
</flowgorithm>
